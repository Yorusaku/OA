{
  "name": "panorama-oa-web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare:contracts": "pnpm --filter @oa/contracts build",
    "dev": "pnpm run prepare:contracts && vite",
    "dev:full": "node ./scripts/run-vite-mode.mjs full dev",
    "dev:ondemand": "node ./scripts/run-vite-mode.mjs ondemand dev",
    "build": "pnpm run prepare:contracts && vite build",
    "build:analyze": "vite build --mode analyze",
    "build:full": "node ./scripts/run-vite-mode.mjs full build",
    "build:ondemand": "node ./scripts/run-vite-mode.mjs ondemand build",
    "preview": "vite preview",
    "preview:full": "node ./scripts/run-vite-mode.mjs full preview",
    "preview:ondemand": "node ./scripts/run-vite-mode.mjs ondemand preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "typecheck": "pnpm run prepare:contracts && vue-tsc --noEmit",
    "test": "pnpm run prepare:contracts && vitest",
    "test:coverage": "pnpm run prepare:contracts && vitest --coverage",
    "test:smoke": "node ./scripts/run-playwright-mode.mjs ondemand e2e/smoke.spec.ts",
    "test:smoke:ondemand": "node ./scripts/run-playwright-mode.mjs ondemand e2e/smoke.spec.ts",
    "test:smoke:full": "node ./scripts/run-playwright-mode.mjs full e2e/smoke.spec.ts",
    "test:e2e:chrome": "node ./scripts/run-playwright-mode.mjs ondemand",
    "test:e2e:chrome:ondemand": "node ./scripts/run-playwright-mode.mjs ondemand",
    "test:e2e:chrome:full": "node ./scripts/run-playwright-mode.mjs full",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse": "lhci autorun",
    "verify:matrix": "node ./scripts/verify-matrix.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@form-create/element-ui": "3.2.0",
    "@logicflow/core": "^2.1.11",
    "@logicflow/extension": "^2.1.13",
    "@oa/contracts": "workspace:*",
    "@oa/utils": "workspace:*",
    "@tanstack/vue-query": "^5.92.9",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.12.2",
    "comlink": "^4.4.2",
    "echarts": "^6.0.0",
    "element-plus": "2.13.2",
    "lodash-es": "^4.17.23",
    "msw": "^2.0.0",
    "nanoid": "^5.1.6",
    "pdfjs-dist": "^5.4.624",
    "pinia": "^3.0.4",
    "vue": "3.5.38",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@oa/config": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
