{
  "name": "panorama-oa-bff",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare:workspace": "pnpm --filter @oa/contracts build && pnpm --filter @oa/ai-utils build",
    "dev": "pnpm run prepare:workspace && tsx watch src/server.ts",
    "build": "pnpm run prepare:workspace && tsc -p tsconfig.build.json",
    "start": "node --experimental-specifier-resolution=node dist/server.js",
    "typecheck": "pnpm run prepare:workspace && tsc --noEmit",
    "test": "pnpm run prepare:workspace && vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@oa/contracts": "workspace:*",
    "@oa/ai-utils": "workspace:*",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "latest",
    "vitest": "^4.0.8"
  }
}
